# DeepGuard / Deepfake Adaptive Fusion API — configuration (12-factor).
# Copy to `.env` (next to manage.py) and adjust; every value is optional.

# --- artefacts ---------------------------------------------------------
# Drop your TRAINED checkpoint here to replace the shipped CI dummy weights:
#   models/AdaptiveFusion_best_model.pth   (PyTorch, used by Grad-CAM)
#   models/deepfake_fusion.onnx            (ONNX, used by POST /predict)
#   models/model_config.json               (backbone, image size, ...)
MODEL_PATH=models/deepfake_fusion.onnx
PYTORCH_CHECKPOINT_PATH=models/AdaptiveFusion_best_model.pth
MODEL_CONFIG_PATH=models/model_config.json
METRICS_PATH=reports/metrics.json

# --- inference ---------------------------------------------------------
DECISION_THRESHOLD=0.5
MAX_UPLOAD_MB=10
ONNX_PROVIDERS=CPUExecutionProvider
ENABLE_GRADCAM=1
TORCH_DEVICE=auto

# --- HTTP --------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
LOG_LEVEL=INFO
MODEL_VERSION=1.0.0

# --- frontend ----------------------------------------------------------
# Built React app served by Django when present (npm run build in ../frontend).
# In dev, the Vite server (:5173) proxies /predict, /health, /model and /media
# to this backend, so this path only matters for the single-server mode.
#FRONTEND_PATH=../frontend/dist/index.html
#MEDIA_DIR=media
